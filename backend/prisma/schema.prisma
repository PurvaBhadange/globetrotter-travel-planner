generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Core models needed for authentication and basic trip handling
model User {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations (optional – keep for future expansion)
  trips        Trip[]
}

model Trip {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  status    String   @default("planning")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Placeholder relations – can be expanded later
  // stops          TripStop[]
  // expenses       TripExpense[]
  // collaborators  TripCollaborator[]
  // aiSuggestions  AiSuggestion[]
  // communityPosts CommunityPost[]
}

// Minimal placeholder models so Prisma doesn't complain about missing types.
model TripStop {
  id String @id @default(uuid())
}

model TripExpense {
  id String @id @default(uuid())
}

model TripCollaborator {
  id String @id @default(uuid())
}

model TripExpenseSplit {
  id String @id @default(uuid())
}

model CommunityPost {
  id String @id @default(uuid())
}

model CommunityComment {
  id String @id @default(uuid())
}

model AiSuggestion {
  id String @id @default(uuid())
}
